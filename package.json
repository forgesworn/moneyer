{
  "name": "@forgesworn/moneyer",
  "version": "0.1.0",
  "private": true,
  "description": "An LNURLcash (LUD-25) mint - strikes Lightning bearer notes. Independent implementation, cln/lnd funding sources, SQLite, zero HTTP framework.",
  "author": "TheCryptoDonkey",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "moneyer": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "THREAT-MODEL.md",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev": "node --experimental-strip-types src/cli.ts --dev",
    "conform": "node test/run-grader.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm pack --dry-run"
  },
  "dependencies": {
    "@noble/curves": "^2.3.0",
    "@noble/hashes": "^2.3.0",
    "@scure/base": "^1.2.4",
    "farrier-kit": "^1.1.3",
    "lnurlcash-kit": "file:../lnurlcash-kit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "lnurlcash-conformance": "file:../lnurlcash-conformance",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
